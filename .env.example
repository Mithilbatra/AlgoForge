# Copy to .env (Docker Compose reads it) or export in your shell. Never commit real values.

# PostgreSQL (the local compose database's password; never leave it empty: an empty value overrides the default)
DATABASE_URL=jdbc:postgresql://localhost:5432/algoforge
DATABASE_USER=algoforge
DATABASE_PASSWORD=algoforge

# AI providers (server-side only; leave empty to run without AI)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AI_DUAL_MODE=false
AI_REQUESTS_PER_HOUR=20

# Execution worker
SANDBOX_RUNTIME=
WORKER_THREADS=2

# Web and security
COOKIE_SECURE=false
REGISTRATIONS_PER_15_MINUTES=5
LOGINS_PER_15_MINUTES=10
SUBMISSIONS_PER_MINUTE=10
RUNS_PER_MINUTE=20
# Serve the OpenAPI description at /api/docs and Swagger UI at /api/docs/ui (development only)
API_DOCS=false
